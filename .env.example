# Supabase project settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser. Either the legacy service_role key
# or a new secret key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=
# Only for applying migrations from a dev machine (Session pooler URI). Not needed on Vercel.
DATABASE_URL=

# Sarvam AI: text-to-speech for seeded meetings, speech-to-text for uploads
SARVAM_API_KEY=
# Groq: summaries and action items
GROQ_API_KEY=
